# Facai Cloud production environment.
#
# Install as /etc/facai-cloud/facai.env, owned by root:facai with mode 0640:
#   install -d -m 0750 -o root -g facai /etc/facai-cloud
#   install -m 0640 -o root -g facai facai.env.example /etc/facai-cloud/facai.env
# Then edit it and fill in real secrets. NEVER commit this file with values.
# Secrets stay in the environment; they are not written to the database or logs.

# Runtime data directory (database, workspaces, backups). Must be writable by the service user.
FACAI_DATA_DIR=/opt/facai-cloud/data

# Admin console login. FACAI_ADMIN_PASSWORD is required to enable authentication.
FACAI_ADMIN_USER=admin
FACAI_ADMIN_PASSWORD=

# Session lifetime in seconds (default 8h) and login throttle.
FACAI_SESSION_TTL=28800
FACAI_LOGIN_MAX_FAILURES=5
FACAI_LOGIN_WINDOW=300

# Set to 1 because the app sits behind an HTTPS reverse proxy.
FACAI_COOKIE_SECURE=1
FACAI_TRUST_PROXY=1

# HTTP Basic read-only gate. Set to 1 to refuse Basic on non-safe methods
# (browsers replay cached credentials on a cross-site form post); writes must
# then use a login session with its CSRF token. 0 keeps script-style Basic
# writes working and logs a warning when one is used.
FACAI_BASIC_READONLY=0

# Scheduler concurrency.
FACAI_MAX_WORKERS=2

# Anti-resale throttle (反代转售审计): per-owner ceiling on IN-FLIGHT
# (WAITING/RUNNING) missions. A client whose automation treats the platform as
# an upstream hits 402 with Chinese copy once this many of their missions are
# in flight; finishing or cancelling steps frees the slots. The companion
# creation-RATE limit (6 missions/minute/owner, in-memory sliding window) is
# not configurable: 402 and 429 copy are distinct on purpose.
FACAI_MAX_ACTIVE_MISSIONS_PER_OWNER=10

# Model credentials are classified by service and live one-per-file under
# /etc/facai-cloud/providers/ (mode 0640, root:facai), not here. For example the
# DeepSeek key goes in /etc/facai-cloud/providers/deepseek.env under its own
# provider key name. The systemd unit loads both this file and
# /etc/facai-cloud/providers/*.env. Never paste a key into source control.

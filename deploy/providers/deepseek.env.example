# DeepSeek provider credential, classified by service.
#
# Install as /etc/facai-cloud/providers/deepseek.env, owned by root:facai with
# mode 0640:
#   install -d -m 0750 -o root -g facai /etc/facai-cloud/providers
#   install -m 0640 -o root -g facai deepseek.env.example /etc/facai-cloud/providers/deepseek.env
# Then edit it and fill in the real value. NEVER commit this file with a value.
#
# The model registry references this credential by name only
# (api_key_env=DEEPSEEK_API_KEY); the raw value stays in the environment and is
# never written to the database, logs or Git.
DEEPSEEK_API_KEY=

# Telegram channel credential, classified by service.
#
# Text messaging adapter. Configure a BotFather token and a 1-256 character
# webhook secret (A-Z, a-z, 0-9, underscore, hyphen). Never put values in Git.
# Register POST https://whstapp.lol/api/v1/channels/telegram/webhook through
# Telegram setWebhook with the same secret_token. GET verification is not used.
#
# Install as /etc/facai-cloud/providers/telegram.env, owned by root:facai with
# mode 0640. NEVER commit this file with values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

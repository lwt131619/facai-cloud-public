# WhatsApp Cloud API credential, classified by service.
#
# Install as /etc/facai-cloud/providers/whatsapp.env, owned by root:facai with
# mode 0640:
#   install -d -m 0750 -o root -g facai /etc/facai-cloud/providers
#   install -m 0640 -o root -g facai whatsapp.env.example /etc/facai-cloud/providers/whatsapp.env
# Then edit it and fill in the real values. NEVER commit this file with values.
#
# The channel layer reads these by name from the process environment; no value is
# written to the database, a log or Git. Until every value is present the
# WhatsApp channel reports UNCONFIGURED and refuses to send.
#
# Verify token chosen by you and entered in the Meta App webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret, used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Permanent access token for the WhatsApp Business account.
WHATSAPP_ACCESS_TOKEN=
# The phone number ID that sends the messages.
WHATSAPP_PHONE_NUMBER_ID=
# Optional Graph API version override; defaults to v21.0.
# WHATSAPP_GRAPH_VERSION=v21.0
